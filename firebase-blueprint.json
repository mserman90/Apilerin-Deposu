{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User ID, must match document ID"
        },
        "email": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "timestamp"
        }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    }
  }
}
